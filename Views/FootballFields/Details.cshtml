@model FootballFieldBooking_New.Models.FootballField
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách sân</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Image -->
        <div class="col-md-6 mb-4">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name"
                 onerror="this.src='/images/default-field.jpg'">
        </div>

        <!-- Info -->
        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <p class="lead">
                <span class="badge bg-success fs-6">@Model.FieldType.Name</span>
                <span class="badge bg-info text-dark fs-6">@Model.FieldType.PlayerCount người</span>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success fs-6">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Tạm ngưng</span>
                }
            </p>

            <!-- ⭐ THÊM: Hiển thị Rating -->
            @if (Model.TotalReviews > 0)
            {
                <div class="mb-3">
                    <div class="d-flex align-items-center">
                        <h4 class="text-warning mb-0 me-2">@Model.AverageRating.ToString("F1")</h4>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(Model.AverageRating))
                                {
                                    <i class="bi bi-star-fill text-warning fs-5"></i>
                                }
                                else if (i - 0.5 <= Model.AverageRating)
                                {
                                    <i class="bi bi-star-half text-warning fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning fs-5"></i>
                                }
                            }
                        </div>
                        <small class="text-muted ms-2">(@Model.TotalReviews đánh giá)</small>
                    </div>
                </div>
            }

            <hr>

            <h5><i class="bi bi-geo-alt text-danger"></i> Vị trí</h5>
            <p>@Model.Location</p>

            <h5><i class="bi bi-info-circle"></i> Mô tả</h5>
            <p>@Model.Description</p>

            <h5><i class="bi bi-cash-coin text-success"></i> Giá</h5>
            <p>
                Từ <strong class="text-success">@ViewBag.MinPrice.ToString("N0") VNĐ</strong>
                đến <strong class="text-success">@ViewBag.MaxPrice.ToString("N0") VNĐ</strong> /giờ
            </p>

            <h5><i class="bi bi-clock"></i> Khung giờ</h5>
            <p>Có <strong>@ViewBag.TotalSlots</strong> khung giờ</p>

            <div class="d-grid gap-2 mt-4">
                <a asp-controller="Bookings" asp-action="Create" asp-route-fieldId="@Model.Id"
                   class="btn btn-success btn-lg">
                    <i class="bi bi-calendar-check"></i> Đặt sân ngay
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>

    <!-- Time Slots Table -->
    <div class="mt-5">
        <h3><i class="bi bi-clock"></i> Bảng giá theo khung giờ</h3>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-success">
                            <tr>
                                <th>Khung giờ</th>
                                <th>Giá (VNĐ/giờ)</th>
                                <th>Loại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in Model.TimeSlots.OrderBy(ts => ts.StartTime))
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-clock"></i>
                                        @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td class="fw-bold text-success">@slot.PricePerHour.ToString("N0")</td>
                                    <td>
                                        @if (slot.IsWeekend)
                                        {
                                            <span class="badge bg-warning text-dark">Cuối tuần</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Ngày thường</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- ⭐ PHẦN MỚI: REVIEWS SECTION -->
    <!-- ========================================== -->
    <div class="mt-5" id="reviews-section">
        <h3>
            <i class="bi bi-chat-left-text"></i> Đánh giá từ khách hàng
            <span class="badge bg-secondary">@Model.TotalReviews đánh giá</span>
        </h3>

        @if (Model.TotalReviews > 0)
        {
            <!-- Average Rating Card -->
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-body text-center py-4">
                    <h1 class="display-3 text-warning mb-0">@Model.AverageRating.ToString("F1")</h1>
                    <div class="mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Floor(Model.AverageRating))
                            {
                                <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                            }
                            else if (i - 0.5 <= Model.AverageRating)
                            {
                                <i class="bi bi-star-half text-warning" style="font-size: 1.5rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-warning" style="font-size: 1.5rem;"></i>
                            }
                        }
                    </div>
                    <p class="text-muted mb-0">Dựa trên @Model.TotalReviews đánh giá</p>
                </div>
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            var userReview = Model.Reviews.FirstOrDefault(r => r.UserId == userId);
            var hasCompletedBooking = Model.Bookings.Any(b => b.UserId == userId && b.Status == BookingStatus.Completed);

            @if (userReview == null && hasCompletedBooking)
            {
                <!-- Review Form (User chưa review) -->
                <div class="card shadow-sm mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil-square"></i> Viết đánh giá của bạn
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Reviews" asp-action="Create" method="post">
                            <input type="hidden" name="fieldId" value="@Model.Id" />

                            <!-- Rating Input -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-star-fill text-warning"></i> Đánh giá <span class="text-danger">*</span>
                                </label>
                                <div class="rating-input" id="ratingInput">
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        <input type="radio" name="rating" value="@i" id="star@(i)" required>
                                        <label for="star@(i)">★</label>
                                    }
                                </div>
                                <small class="text-muted">Nhấp vào sao để đánh giá</small>
                            </div>

                            <!-- Comment -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-chat-left-text"></i> Nhận xét <span class="text-danger">*</span>
                                </label>
                                <textarea name="comment" class="form-control" rows="4"
                                          placeholder="Chia sẻ trải nghiệm của bạn về sân này..."
                                          required minlength="10" maxlength="1000"></textarea>
                                <small class="text-muted">Tối thiểu 10 ký tự, tối đa 1000 ký tự</small>
                            </div>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-send"></i> Gửi đánh giá
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (userReview != null)
            {
                <!-- User's Review (Có thể edit/delete) -->
                <div class="card shadow-sm mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="bi bi-person-check"></i> Đánh giá của bạn
                            </h6>
                            <div>
                                <a asp-controller="Reviews" asp-action="Edit" asp-route-id="@userReview.Id"
                                   class="btn btn-sm btn-light">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@userReview.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= userReview.Rating)
                                {
                                    <i class="bi bi-star-fill text-warning fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning fs-5"></i>
                                }
                            }
                        </div>
                        <p class="mb-1">@userReview.Comment</p>
                        <small class="text-muted">
                            <i class="bi bi-clock"></i> @userReview.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            @if (userReview.UpdatedDate != null)
                            {
                                <span class="badge bg-info text-dark">Đã sửa: @userReview.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </small>
                    </div>
                </div>
            }
            else if (!hasCompletedBooking)
            {
                <!-- Thông báo cần hoàn thành booking -->
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    <strong>Lưu ý:</strong> Bạn cần hoàn thành ít nhất một lần đặt sân để có thể đánh giá.
                </div>
            }
        }
        else
        {
            <!-- User chưa đăng nhập -->
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Đăng nhập để đánh giá!</strong>
                <a href="/Identity/Account/Login?returnUrl=@Url.Action("Details", new { id = Model.Id })" class="alert-link">
                    Đăng nhập ngay
                </a>
            </div>
        }

        <!-- All Reviews List -->
        @if (Model.Reviews.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-dots"></i> Tất cả đánh giá (@Model.TotalReviews)
                    </h5>
                </div>
                <div class="card-body">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedDate))
                    {
                        var isCurrentUser = User.Identity?.IsAuthenticated == true && review.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier);

                        <div class="review-item mb-4 pb-3 @(isCurrentUser ? "" : "border-bottom")">
                            <div class="d-flex gap-3">
                                <!-- Avatar -->
                                <div class="flex-shrink-0">
                                    <i class="bi bi-person-circle text-success" style="font-size: 3rem;"></i>
                                </div>

                                <!-- Content -->
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <strong class="d-block">@review.User.UserName</strong>
                                            <div>
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="bi bi-star-fill text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-warning"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i> @review.CreatedDate.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>

                                    <p class="mb-1">@review.Comment</p>

                                    @if (review.UpdatedDate != null)
                                    {
                                        <small class="text-muted">
                                            <i class="bi bi-pencil"></i> Đã chỉnh sửa
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-chat-left-dots fs-1 d-block mb-2"></i>
                <h5>Chưa có đánh giá nào</h5>
                <p class="mb-0">Hãy là người đầu tiên đánh giá sân này!</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <style>
        /* Rating Input Styles */
        .rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-start;
            gap: 5px;
            font-size: 2.5rem;
        }

            .rating-input input {
                display: none;
            }

            .rating-input label {
                cursor: pointer;
                color: #ddd;
                transition: all 0.2s ease;
            }

                .rating-input input:checked ~ label,
                .rating-input label:hover,
                .rating-input label:hover ~ label {
                    color: #ffc107;
                    transform: scale(1.1);
                }

        /* Review Item Styles */
        .review-item:last-child {
            border-bottom: none !important;
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }

        /* Smooth scroll to reviews */
        html {
            scroll-behavior: smooth;
        }

        /* Hover effect for review cards */
        .review-item {
            transition: background-color 0.2s ease;
        }

            .review-item:hover {
                background-color: #f8f9fa;
                border-radius: 8px;
                padding: 12px;
                margin: -12px;
                margin-bottom: 16px;
            }
    </style>

    <script>
        // Auto scroll to reviews if hash present
        $(document).ready(function() {
            if (window.location.hash === '#reviews') {
                $('html, body').animate({
                    scrollTop: $('#reviews-section').offset().top - 100
                }, 500);
            }
        });
    </script>
}