@model IEnumerable<dynamic>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-trophy"></i> Sân phổ biến</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <a href="/FootballFields/Details/@item.FootballFieldId"
                       class="list-group-item list-group-item-action">
                        <div class="d-flex align-items-center">
                            <img src="@item.ImageUrl"
                                 class="rounded me-3"
                                 alt="@item.Name"
                                 style="width: 60px; height: 60px; object-fit: cover;"
                                 onerror="this.src='/images/default-field.jpg'" />
                            <div class="flex-grow-1">
                                <h6 class="mb-1">@item.Name</h6>
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @item.Location
                                </small>
                                <br>
                                <small class="text-muted">
                                    <span class="badge bg-info text-dark">@item.FieldTypeName</span>
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary rounded-pill">
                                    @item.BookingCount lượt
                                </span>
                                <br>
                                <small class="text-success">
                                    @item.TotalRevenue.ToString("N0") VNĐ
                                </small>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="p-3 text-center text-muted">
                <i class="bi bi-info-circle"></i> Chưa có dữ liệu
            </div>
        }
    </div>
    <div class="card-footer bg-white text-center">
        <a href="/FootballFields" class="text-success text-decoration-none">
            Xem tất cả sân <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>