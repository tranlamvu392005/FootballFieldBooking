@model IEnumerable<FootballFieldBooking_New.Models.Booking>

<div class="card shadow-sm border-info">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-bell"></i> Lịch sắp tới</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var booking in Model)
                {
                    var daysUntil = (booking.PlayDate - DateTime.Now).Days;
                    var badgeClass = daysUntil <= 1 ? "bg-danger" : (daysUntil <= 3 ? "bg-warning text-dark" : "bg-success");

                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="mb-1">
                                    <i class="bi bi-grid text-success"></i>
                                    @booking.FootballField.Name
                                </h6>
                                <p class="mb-1">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar"></i>
                                        @booking.PlayDate.ToString("dd/MM/yyyy")
                                        (@booking.PlayDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN")))
                                    </small>
                                </p>
                                <p class="mb-0">
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i>
                                        @booking.TimeSlot.StartTime.ToString(@"hh\:mm") -
                                        @booking.TimeSlot.EndTime.ToString(@"hh\:mm")
                                    </small>
                                </p>
                            </div>
                            <div class="text-end ms-2">
                                <span class="badge @badgeClass mb-1">
                                    @if (daysUntil == 0)
                                    {
                                        <span>Hôm nay!</span>
                                    }
                                    else if (daysUntil == 1)
                                    {
                                        <span>Ngày mai</span>
                                    }
                                    else
                                    {
                                        <span>@daysUntil ngày nữa</span>
                                    }
                                </span>
                                <br>
                                <a href="/Bookings/Details/@booking.Id" class="btn btn-sm btn-outline-info mt-1">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2">Không có lịch sắp tới trong 7 ngày</p>
                <a href="/FootballFields" class="btn btn-sm btn-success mt-2">
                    <i class="bi bi-plus-circle"></i> Đặt sân ngay
                </a>
            </div>
        }
    </div>
    @if (Model.Any())
    {
        <div class="card-footer bg-white text-center">
            <a href="/Bookings" class="text-info text-decoration-none">
                Xem tất cả lịch đặt <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    }
</div>