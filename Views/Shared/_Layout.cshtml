@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FootballFieldBooking_New</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FootballFieldBooking_New.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-enhanced.css" asp-append-version="true" />
  
    <style>
        :root {
            --primary-green: #10b981;
            --dark-green: #059669;
            --light-green: #d1fae5;
            --dark-bg: #1a1a1a;
            --darker-bg: #0f0f0f;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e8f5e9 100%);
            min-height: 100vh;
        }

        /* Modern Navbar */
        .navbar {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%) !important;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 1rem 0;
            border: none !important;
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-green) !important;
            transition: all 0.3s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.05);
            color: var(--dark-green) !important;
        }

        .navbar-brand i {
            font-size: 1.8rem;
            vertical-align: middle;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .nav-link {
            position: relative;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: #333 !important;
        }

        .nav-link:hover {
            background: var(--light-green);
            color: var(--dark-green) !important;
            transform: translateY(-2px);
        }

        .nav-link i {
            margin-right: 5px;
            transition: transform 0.3s ease;
        }

        .nav-link:hover i {
            transform: scale(1.2);
        }

        /* Admin Links Special Style */
        .nav-link.text-danger {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            color: #dc2626 !important;
            border: 2px solid #fca5a5;
        }

        .nav-link.text-danger:hover {
            background: linear-gradient(135deg, #fca5a5 0%, #ef4444 100%);
            color: white !important;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
        }

        /* Notification Badge */
        .notification-btn {
            position: relative;
        }

        .notification-badge {
            animation: bounce 1s infinite;
        }

        @@keyframes bounce {
            0%, 100% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.2); }
        }

        /* Toast Notification */
        .toast {
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.15);
            border: none;
        }

        .toast-header {
            border-radius: 12px 12px 0 0 !important;
            background: linear-gradient(135deg, var(--primary-green) 0%, var(--dark-green) 100%) !important;
        }

        /* Alert Messages */
        .alert {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
            animation: slideDown 0.4s ease;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            color: #065f46;
        }

        .alert-danger {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            color: #991b1b;
        }

        /* Main Content */
        #page-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        #content-wrap {
            flex: 1;
        }

        .container main {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.08);
            margin-top: 2rem;
        }

        /* Modern Footer */
        .footer {
            background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%) !important;
            color: #e5e5e5 !important;
            position: relative;
            overflow: hidden;
        }

        .footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-green) 0%, var(--dark-green) 50%, var(--primary-green) 100%);
        }

        .footer h5, .footer h6 {
            position: relative;
            padding-bottom: 10px;
        }

        .footer h5::after, .footer h6::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 50px;
            height: 3px;
            background: var(--primary-green);
            border-radius: 2px;
        }

        .footer-link {
            color: #d1d5db;
            text-decoration: none;
            display: inline-block;
            padding: 5px 0;
            transition: all 0.3s ease;
            position: relative;
        }

        .footer-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary-green);
            transition: width 0.3s ease;
        }

        .footer-link:hover {
            color: var(--primary-green);
            padding-left: 10px;
        }

        .footer-link:hover::before {
            width: 100%;
        }

        .social-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }

        .social-icon:hover {
            background: var(--primary-green);
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(16, 185, 129, 0.3);
        }

        .social-icon i {
            font-size: 1.3rem !important;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.2rem;
            }
            
            .nav-link {
                margin: 5px 0;
            }
            
            .container main {
                padding: 1rem;
            }
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-green);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--dark-green);
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(16, 185, 129, 0.3);
            border-radius: 50%;
            border-top-color: var(--primary-green);
            animation: spin 1s ease-in-out infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>

<body>
    <!-- Toast Container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="liveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle me-2"></i>
                <strong class="me-auto">Thông báo</strong>
                <small>Vừa xong</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                <!-- Dynamic content -->
            </div>
        </div>
    </div>

    <div id="page-container">
        <div id="content-wrap">
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-trophy-fill"></i> Football Booking
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door-fill"></i> Trang chủ
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="FootballFields" asp-action="Index">
                                        <i class="bi bi-grid-3x3-gap-fill"></i> Danh sách sân
                                    </a>
                                </li>

                                @if (SignInManager.IsSignedIn(User))
                                {
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-danger fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-shield-fill-check"></i> Admin Panel
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-danger" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                                <i class="bi bi-people-fill"></i> Quản lý User
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Bookings" asp-action="Index">
                                                <i class="bi bi-calendar-check-fill"></i> Lịch sử
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index">
                                                <i class="bi bi-person-circle"></i> Tài khoản
                                            </a>
                                        </li>
                                        
                                    }
                                }
                            </ul>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </header>

            <div class="container">
                <!-- Success/Error Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

        <footer class="footer text-light border-top mt-auto">
            <div class="container py-5">
                <div class="row">
                    <!-- Giới thiệu -->
                    <div class="col-md-4 mb-4 mb-md-0">
                        <h5 class="mb-3"><i class="bi bi-trophy-fill"></i> Football Booking</h5>
                        <p class="small text-light opacity-75">
                            Hệ thống đặt sân bóng đá trực tuyến hàng đầu Việt Nam.
                            Nhanh chóng, tiện lợi, uy tín.
                        </p>
                        <div class="d-flex gap-2 mt-4">
                            <a href="#" class="social-icon text-light">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <a href="#" class="social-icon text-light">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="#" class="social-icon text-light">
                                <i class="bi bi-twitter"></i>
                            </a>
                            <a href="#" class="social-icon text-light">
                                <i class="bi bi-youtube"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Liên kết nhanh -->
                    <div class="col-md-4 mb-4 mb-md-0">
                        <h6 class="mb-3">Liên kết nhanh</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a asp-controller="Home" asp-action="Index" class="footer-link">
                                    <i class="bi bi-chevron-right"></i> Trang chủ
                                </a>
                            </li>
                            <li class="mb-2">
                                <a asp-controller="FootballFields" asp-action="Index" class="footer-link">
                                    <i class="bi bi-chevron-right"></i> Danh sách sân
                                </a>
                            </li>
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="mb-2">
                                    <a asp-controller="Bookings" asp-action="Index" class="footer-link">
                                        <i class="bi bi-chevron-right"></i> Lịch sử đặt sân
                                    </a>
                                </li>
                            }
                            <li class="mb-2">
                                <a asp-controller="Home" asp-action="Privacy" class="footer-link">
                                    <i class="bi bi-chevron-right"></i> Chính sách
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Liên hệ -->
                    <div class="col-md-4">
                        <h6 class="mb-3">Liên hệ</h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="bi bi-geo-alt-fill text-success me-2"></i>
                                <span class="text-light opacity-75">123 Đường ABC, Quận 1, TP.HCM</span>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-telephone-fill text-success me-2"></i>
                                <a href="tel:1900xxxx" class="footer-link">1900-xxxx</a>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-envelope-fill text-success me-2"></i>
                                <a href="mailto:info@footballbooking.com" class="footer-link">info@footballbooking.com</a>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-clock-fill text-success me-2"></i>
                                <span class="text-light opacity-75">Mở cửa: 6:00 - 22:00 hàng ngày</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <hr class="my-4 border-secondary opacity-25">

                <div class="row">
                    <div class="col-md-6 text-center text-md-start">
                        <small class="opacity-75">&copy; 2024 - FootballFieldBooking. All rights reserved.</small>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <small class="opacity-75">Made with <i class="bi bi-heart-fill text-danger"></i> in Vietnam</small>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>