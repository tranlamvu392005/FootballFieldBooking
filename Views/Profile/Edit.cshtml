@model FootballFieldBooking_New.Controllers.EditProfileViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-gear"></i> Chỉnh sửa thông tin cá nhân
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Account Info -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-person-badge"></i> Thông tin tài khoản
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>

                            <!-- ✅ SỬA Ở ĐÂY -->
                            <input asp-for="Email" class="form-control" readonly />
                            <!-- ✅ Nếu bạn muốn giao diện xám như disabled, dùng thêm dòng sau -->
                            <!-- <input type="hidden" asp-for="Email" /> -->

                            <small class="text-muted">Email không thể thay đổi</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Personal Info -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-person"></i> Thông tin cá nhân
                        </h5>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="3"
                                      placeholder="Nhập địa chỉ chi tiết"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label"></label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Male">Nam</option>
                                    <option value="Female">Nữ</option>
                                    <option value="Other">Khác</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Info Alert -->
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Lưu ý:</strong> Thông tin này sẽ được sử dụng để xác nhận khi bạn đến sân.
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Cập nhật thông tin
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Info Card -->
            <div class="card shadow mt-3">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-shield-lock"></i> Bảo mật tài khoản
                    </h6>
                    <p class="mb-2">
                        <a href="/Identity/Account/Manage/ChangePassword" class="text-decoration-none">
                            <i class="bi bi-key"></i> Đổi mật khẩu
                        </a>
                    </p>
                    <p class="mb-0">
                        <a href="/Identity/Account/Manage/Email" class="text-decoration-none">
                            <i class="bi bi-envelope"></i> Xác thực email
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
