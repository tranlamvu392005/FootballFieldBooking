@model FootballFieldBooking_New.Areas.Admin.Controllers.UserDetailViewModel

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="bi bi-person-circle"></i> Chi tiết người dùng</h2>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- User Info Card -->
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body text-center">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.Profile?.AvatarUrl))
                    {
                        <img src="@Model.Profile.AvatarUrl" alt="Avatar"
                             class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                    }
                    else
                    {
                        <i class="bi bi-person-circle text-muted" style="font-size: 150px;"></i>
                    }
                </div>
                <h4 class="mb-1">@(Model.Profile?.FullName ?? "N/A")</h4>
                <p class="text-muted">@Model.Email</p>

                <!-- Roles -->
                <div class="mb-3">
                    @foreach (var role in Model.Roles)
                    {
                        if (role == "Admin")
                        {
                            <span class="badge bg-danger">@role</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@role</span>
                        }
                    }
                </div>

                <!-- Status -->
                <div class="mb-3">
                    @if (Model.LockoutEnd != null && Model.LockoutEnd > DateTimeOffset.Now)
                    {
                        <span class="badge bg-danger">
                            <i class="bi bi-lock"></i> Đã khóa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i> Hoạt động
                        </span>
                    }

                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-envelope-check"></i> Email đã xác thực
                        </span>
                    }
                </div>

                <!-- Actions -->
                <form asp-action="ToggleLock" asp-route-id="@Model.Id" method="post" class="d-grid">
                    @if (Model.LockoutEnd != null && Model.LockoutEnd > DateTimeOffset.Now)
                    {
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-unlock"></i> Mở khóa tài khoản
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Khóa tài khoản này?')">
                            <i class="bi bi-lock"></i> Khóa tài khoản
                        </button>
                    }
                </form>
            </div>
        </div>

        <!-- Stats Card -->
        <div class="card shadow mt-3">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="bi bi-graph-up"></i> Thống kê</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-7">Tổng đơn đặt:</dt>
                    <dd class="col-sm-5 text-end"><strong>@Model.TotalBookings</strong></dd>

                    <dt class="col-sm-7">Tổng chi tiêu:</dt>
                    <dd class="col-sm-5 text-end text-success">
                        <strong><price amount="@Model.TotalSpent" size="small"></price></strong>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Details & Bookings -->
    <div class="col-md-8">
        <!-- Personal Info -->
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Thông tin cá nhân</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Username:</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Số điện thoại:</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "N/A")</dd>

                    <dt class="col-sm-4">Họ và tên:</dt>
                    <dd class="col-sm-8">@(Model.Profile?.FullName ?? "N/A")</dd>

                    <dt class="col-sm-4">Địa chỉ:</dt>
                    <dd class="col-sm-8">@(Model.Profile?.Address ?? "N/A")</dd>

                    <dt class="col-sm-4">Ngày sinh:</dt>
                    <dd class="col-sm-8">
                        @(Model.Profile?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")
                    </dd>

                    <dt class="col-sm-4">Giới tính:</dt>
                    <dd class="col-sm-8">
                        @(Model.Profile?.Gender switch
                        {
                            "Male" => "Nam",
                            "Female" => "Nữ",
                            "Other" => "Khác",
                            _ => "N/A"
                        })
                    </dd>

                    <dt class="col-sm-4">Ngày tạo:</dt>
                    <dd class="col-sm-8">
                        @(Model.Profile?.CreatedDate.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Lịch sử đặt sân gần đây</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentBookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Sân</th>
                                    <th>Ngày chơi</th>
                                    <th>Giờ</th>
                                    <th>Giá</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in Model.RecentBookings)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id">
                                                #@booking.Id
                                            </a>
                                        </td>
                                        <td>@booking.FootballField.Name</td>
                                        <td>@booking.PlayDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @booking.TimeSlot.StartTime.ToString(@"hh\:mm") -
                                            @booking.TimeSlot.EndTime.ToString(@"hh\:mm")
                                        </td>
                                        <td><price amount="@booking.TotalPrice" size="small"></price></td>
                                        <td><status-badge status="@booking.Status" show-icon="false"></status-badge></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-info">
                            Xem tất cả đơn đặt <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0">Chưa có lịch sử đặt sân</p>
                }
            </div>
        </div>
    </div>
</div>